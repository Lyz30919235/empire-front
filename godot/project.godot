; 帝国：四线战令 Godot 2.1
config_version=5

[application]
config/name="帝国：四线战令"
config/version="2.1.0"
config/icon="res://assets/icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="德系二次元战术卡牌 · 四线推进 · 双人联机"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1120
window/size/min_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.085, 0.078, 1)

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
